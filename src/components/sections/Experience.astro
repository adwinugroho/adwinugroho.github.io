---
import Section from "../Section.astro"
import { work } from "@cv"
---

<Section title="Work Experiences">
  <ul>
    {
      work.map(
        ({ name, startDate, endDate, position, summary, highlights, url }) => {
          const startYear = new Date(startDate).getFullYear()
          const endYear =
            endDate != null ? new Date(endDate).getFullYear() : "Actual"

          return (
            <li>
              <article>
                <header>
                  <div>
                    <h3>
                      <a href={url} title={`Visit ${name}`} target="_blank" rel="noopener noreferrer">
                        {name}
                      </a>
                    </h3>
                    <h4>{position}</h4>
                  </div>
                  <div>
                    <time datetime={startDate} data-title={startDate}>{startYear}</time>
                    {"-"}
                    <time datetime={endDate} data-title={endDate}>{endYear}</time>
                  </div>
                </header>

                <p>{summary}</p>

                {highlights && highlights.length > 0 && (
                  <div class="highlights">
                    {highlights.map((point) => (
                      <li>{point}</li>
                    ))}
                  </div>
                )}
              </article>
            </li>
          )
        }
      )
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-left: 0;
    list-style: none;
  }

  article h3 {
    font-weight: 600;
    margin: 0;
  }

  article h4 {
    font-weight: 500;
    color: #444;
    margin: 4px 0 8px;
  }

  article a {
    color: #111;
    text-decoration: none;
  }

  article a:hover {
    text-decoration: underline;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
    cursor: default;
  }

  .highlights {
    margin-top: 4px;
    padding-left: 20px;
    list-style-type: disc;
  }

  .highlights li {
    margin-bottom: 2px;
    line-height: 1.6;
    gap: 4px;
    font-size: 10px;
    font-style: normal; color: #666666;
  }

  [data-title]:hover:after {
    opacity: 1;
    transition: all 0.1s ease-in-out 0.5s;
    visibility: visible;
  }

  [data-title]:after {
    content: attr(data-title);
    background-color: #333;
    color: #fff;
    font-size: 0.75rem;
    font-family: Menlo, Monaco, monospace;
    position: absolute;
    padding: 0.2rem 0.5rem;
    bottom: -1.4rem;
    left: 50%;
    white-space: nowrap;
    box-shadow: 1px 1px 1px #222;
    opacity: 0;
    border: 1px solid #111;
    z-index: 9999;
    visibility: hidden;
    border-radius: 6px;
  }

  [data-title] {
    position: relative;
  }

  @media (max-width: 700px) {
    time {
      text-align: right;
    }

    header {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
  }
</style>
