---
import Section from "../Section.astro";

import { blog } from "@cv";
---

<Section title="Blog">
    <ul class="blog-list">
        {blog.article.map((post) => (
            <li>
                <time datetime={post.date}>
                    {new Date(post.date).toLocaleDateString("en-GB", {
                        day: "2-digit",
                        month: "short",
                        year: "numeric",
                    })}
                </time>
                <a href={post.url}>{post.summary}</a>
            </li>
        ))}
    </ul>
    <a class="blog-more" href={blog.url}>
        View all my writing
    </a>
</Section>

<style>
    .blog-list {
        display: flex;
        flex-direction: column;
        gap: 2px;
        margin-inline: -12px;
        padding: 0;
        list-style: none;
    }

    .blog-list li {
        display: grid;
        grid-template-columns: 7.25rem minmax(0, 1fr);
        gap: 16px;
        align-items: baseline;
        padding: 10px 12px;
        border-radius: 8px;
        font-size: 0.9rem;
        line-height: 1.55;
        transition: background-color 0.15s ease;
    }

    .blog-list li:hover {
        background-color: #f7f7f7;
    }

    .blog-list time {
        color: #777;
        font-size: 0.7rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .blog-list a {
        color: #111;
        overflow-wrap: anywhere;
        text-wrap: pretty;
    }

    .blog-list a:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .blog-more {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 12px;
        padding: 6px 0;
        font-size: 0.8rem;
        color: #555;
        transition: color 0.15s ease;
    }

    .blog-more::after {
        content: "→";
        transition: transform 0.15s ease;
    }

    .blog-more:hover {
        color: #111;
    }

    .blog-more:hover::after {
        transform: translateX(3px);
    }

    @media (max-width: 600px) {
        .blog-list {
            margin-inline: -8px;
        }

        .blog-list li {
            grid-template-columns: minmax(0, 1fr);
            gap: 2px;
            padding: 10px 8px;
            font-size: 0.95rem;
        }

        .blog-list time {
            font-size: 0.65rem;
        }
    }
</style>
