---
import Section from "../Section.astro"
import HTML from "@/icons/html.astro"
import CSS from "@/icons/css.astro"
import JavaScript from "@/icons/javascript.astro"
import php from "@/icons/php.astro"
import TypeScript from "@/icons/type.astro"
import Node from "@/icons/node.astro"
import MySQL from "@/icons/sql.astro"
import Git from "@/icons/git.astro"
import GitHub from "@/icons/GitHub.astro"
import { skills } from "@cv"
import Go from "@/icons/Go.astro"
import PostgreSQL from "@/icons/PostgreSQL.astro"
import ArangoDB from "@/icons/ArangoDB.astro"
import MongoDB from "@/icons/MongoDB.astro"
import Redis from "@/icons/Redis.astro"
import RabbitMQ from "@/icons/RabbitMQ.astro"
import NatsIO from "@/icons/NatsIO.astro"
import Rust from "@/icons/Rust.astro"
import Docker from "@/icons/Docker.astro"
import Kubernetes from "@/icons/Kubernetes.astro"
import Python from "@/icons/Python.astro"

const SKILLS_ICONS: Record<string, any> = {
  HTML,
  CSS,
  JavaScript,
  Go,
  Node,
  TypeScript,
  php,
  Python,
  Rust,
  PostgreSQL,
  MySQL,
  ArangoDB,
  MongoDB,
  Redis,
  RabbitMQ,
  NatsIO,
  Docker,
  Kubernetes,
  Git,
  GitHub,
}
---

<Section title="Skills">
  <ul>
    {
      skills.map(({ name }) => {
        const iconName = name === "Next.js" ? "Next" : name
        const Icon = SKILLS_ICONS[iconName]

        return (
          <li>
            {Icon && <Icon />} <span>{name}</span>
          </li>
        )
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: inline-flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  li {
    align-items: center;
    background: #eee;
    border-radius: 6px;
    color: black;
    display: flex;
    font-size: 0.8rem;
    font-weight: 500;
    gap: 4px;
    padding: 0.2rem 0.6rem;
  }
</style>
